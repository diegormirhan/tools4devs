{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tools4devs",
  "version": "5.0.0",
  "identifier": "com.tools4devs.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tools4Devs",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/*": "tools/"
    },
    "createUpdaterArtifacts": true,
    "publisher": "tools4devs",
    "windows": {
      "wix": {
        "upgradeCode": "aa358e58-31a5-54d8-975a-f12ee846eb55"
      },
      "nsis": {
        "template": "installer/upgrade-compatible.nsi",
        "installerHooks": "installer/migrate-installation.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/diegormirhan/tools4devs/releases/latest/download/tools4devs-updates.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MDdDQjgxMDlCQzkyMDEKUldRQmtyd0pnY3NIbGZmMUYxWHdVdzVBZEYxU2MxWUdnR2RWTXBpNFVQUEZjdG9KQnVKZ3JwNUsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
