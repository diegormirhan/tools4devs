# Frontend
node_modules/
dist/

# Rust / Tauri
target/
apps/desktop/src-tauri/gen/

# Local release artifacts staged for GitHub Releases, one folder per version
/Releases/

# Internal project documentation: kept on disk and in local git history,
# but no longer tracked going forward, so it stops publishing to the
# public remote. README.md and the per-folder technical READMEs stay.
/PRODUCT.md
/DESIGN.md
/docs/*.md
/docs/decisions/*.md

# Generated third-party binaries and build staging
vendor/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/resources/tools/

# Local databases, conversation/session logs and temporary jobs (never track)
*.db
*.db-shm
*.db-wal
logs/
*.session.log
tmp/

# Secrets and machine-local configuration
.env
.env.*
!.env.example
.impeccable/config.local.json

# Tooling that belongs to whoever is working here, not to the project
.agents/
.claude/

# Editors / OS
.idea/
.vscode/
Thumbs.db
Desktop.ini

.preview/

# Update signing keys. The private one lives outside this repository entirely;
# this is a guard against it ever arriving by accident.
*.key
updater.key*

# End-to-end test artifacts
/e2e-report/
